  /* ---------- Footer ---------- */
  .footer { background: var(--navy); color: var(--footer-text); }
  .footer-in { max-width: var(--max); margin: 0 auto; padding: 40px var(--gutter) 100px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px 40px; font-size: 15px; }
  .footer a { color: var(--paper); }
  .footer-name { font-family: var(--serif); font-size: 24px; color: var(--paper); }
  .footer-meta { display: flex; flex-direction: column; gap: 4px; }
